APP_NAME="Car Agency"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Versión que se publica en /docs/api.json
API_VERSION=1.0.0

# Documentación OpenAPI: en local/testing siempre está abierta; en producción
# solo si DOCS_ENABLED=true. Las dev tools solo se cargan con SCRAMBLE_DEV_TOOLS=true.
DOCS_ENABLED=false
SCRAMBLE_DEV_TOOLS=false

# Minutos de vida de los tokens Bearer de Sanctum
SANCTUM_EXPIRATION=120

# Actualizar `last_used_at` en cada petición autenticada. Desactivado evita un
# UPDATE por request; actívalo solo si necesitas auditar el uso de cada token.
SANCTUM_LAST_USED_AT=false

# Prefijo de los tokens nuevos: ayuda a los escáneres de secretos a detectarlos
# si se filtran. Los tokens emitidos antes del cambio siguen siendo válidos.
SANCTUM_TOKEN_PREFIX=car_

# Segundos que se cachean los permisos del usuario (0 desactiva la caché)
PERMISSIONS_CACHE_TTL=300

# Segundos que se cachean los agregados de /api/stats/* (0 desactiva la caché).
STATS_CACHE_TTL=45

# Orígenes permitidos por CORS separados por comas. Usa dominios explícitos en producción.
CORS_ALLOWED_ORIGINS=*

# IPs o rangos CIDR (separados por comas) que pueden enviar X-Forwarded-*.
# Vacío en local: no hay proxy delante. En producción usa la red de Compose
# o la IP del proxy, nunca `*` salvo en una plataforma gestionada.
TRUSTED_PROXIES=

# HSTS: solo se envía si la petición es HTTPS; desactivado en local para no
# fijar HTTPS en el navegador contra http://localhost:8000.
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false

# Límites de peticiones por minuto (login por email+IP; api y reports por usuario/IP)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_IP=20
RATE_LIMIT_API_ANON=30
RATE_LIMIT_API=120
RATE_LIMIT_REPORTS=30
# Los PDF son más caros que el JSON y tienen su propio cupo.
RATE_LIMIT_REPORTS_PDF=5
# `/up` está fuera del grupo `api` y tiene su propio cupo por IP.
RATE_LIMIT_HEALTH=30
# La exportación CSV de auditoría tiene un cupo estricto por usuario.
RATE_LIMIT_AUDIT_EXPORT=10

# Filas máximas del reporte de ventas (0 desactiva el límite). Con Dompdf,
# 300 ventas ≈ 147 MB de memoria y ~2,8 s; 500 ≈ 228 MB y ~6 s.
REPORTS_MAX_ROWS=300
SALES_MIN_DATE=2000-01-01

# Contraseña de los usuarios demo creados por UserSeeder (solo desarrollo)
SEED_USER_PASSWORD=password

# Días que se conservan los registros de audit_logs antes de que
# `audit:prune` (programado a diario) los elimine.
AUDIT_RETENTION_DAYS=90

# Bloquea las rutas salvo /auth/me, /auth/password y /auth/logout cuando el
# usuario tiene must_change_password=true. Desactivado para no romper clientes.
ENFORCE_PASSWORD_CHANGE=false

# Administrador de producción creado por ProductionAdminSeeder. En producción
# ADMIN_EMAIL y ADMIN_PASSWORD son obligatorias: el seeder aborta si faltan, si
# conservan un CHANGE_ME_* o si la clave no cumple la política fuerte (8
# caracteres con mayúsculas, minúsculas, números y símbolos). Fuera de
# producción se usan admin@agency.com / USR-0001 / secret1234 como fallback.
# ADMIN_NAME=Administrador
# ADMIN_LAST_NAME=General
# ADMIN_DOCUMENT_NUMBER=V-00000001
# ADMIN_CODE=USR-0001
# ADMIN_EMAIL=admin@agency.com
# ADMIN_PASSWORD=secret1234

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=api_laravel_car_agency
# Rol de aplicación (no superusuario), creado por docker/postgres/init/01-app-role.sh.
DB_USERNAME=car_agency
DB_PASSWORD=secret
# En local la red de Compose no usa TLS; en producción se sube a `require`.
DB_SSLMODE=prefer
# Sesión de PostgreSQL en UTC: la API guarda y compara fechas en UTC.
DB_TIMEZONE=UTC
# URL completa alternativa (`pgsql://usuario:clave@host:puerto/base`). Vacía para
# usar las variables de arriba.
DB_URL=

# PostgreSQL del stack de desarrollo (ver docker-compose.yml). El superusuario
# solo lo usan la inicialización y los backups; la app entra como car_agency.
# POSTGRES_APP_PASSWORD debe coincidir con DB_PASSWORD.
POSTGRES_DB=api_laravel_car_agency
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_APP_USER=car_agency
POSTGRES_APP_PASSWORD=secret
# Crea además la base `testing` que usa `composer test:postgres`.
POSTGRES_CREATE_TESTING_DB=true
# Ajuste del servidor: shared_buffers ≈ 25 % de la RAM y log de consultas
# lentas (ms) en `docker compose logs postgres`.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=8MB
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000
POSTGRES_INITDB_ARGS="--locale=C.UTF-8 --encoding=UTF8"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
