# =============================================================================
# Plantilla de entorno para PRODUCCIÓN
#
# Es segura para versionar: no contiene credenciales reales, solo marcadores
# CHANGE_ME_*. Uso:
#
#   cp .env.production.example .env.production
#   # sustituye todos los CHANGE_ME_* y genera la APP_KEY:
#   docker compose -f docker-compose.prod.yml --env-file .env.production \
#     run --rm app php artisan key:generate --show
#
# .env.production está ignorado por Git (ver .gitignore); nunca lo subas.
# =============================================================================

APP_NAME="Car Agency"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# -----------------------------------------------------------------------------
# Administrador inicial (ProductionAdminSeeder con `migrate --seed`)
# -----------------------------------------------------------------------------
# Obligatorias en producción. El seeder aborta antes de escribir nada si el
# email falta o conserva un CHANGE_ME_*, o si la clave falta, es la de ejemplo,
# conserva un CHANGE_ME_* o no cumple la política fuerte: 8 caracteres con
# mayúsculas, minúsculas, números y símbolos.
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Administrador
ADMIN_LAST_NAME=General
ADMIN_CODE=USR-0001
ADMIN_DOCUMENT_NUMBER=V-00000001

# Versión que se publica en /docs/api.json
API_VERSION=1.0.0

# La documentación OpenAPI queda cerrada en producción salvo que se active
# explícitamente. Las dev tools nunca se cargan en producción.
DOCS_ENABLED=false
SCRAMBLE_DEV_TOOLS=false

# Minutos de vida de los tokens Bearer de Sanctum
SANCTUM_EXPIRATION=120

# Actualizar `last_used_at` en cada petición autenticada. Desactivado evita un
# UPDATE por request; actívalo solo si necesitas auditar el uso de cada token.
SANCTUM_LAST_USED_AT=false

# Prefijo de los tokens nuevos: ayuda a los escáneres de secretos a detectarlos
# si se filtran. Los tokens emitidos antes del cambio siguen siendo válidos.
SANCTUM_TOKEN_PREFIX=car_

# Segundos que se cachean los permisos del usuario (0 desactiva la caché)
PERMISSIONS_CACHE_TTL=300

# Dominios reales separados por comas. Nunca uses "*" en producción.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Red de Docker Compose: la app confía en Nginx como proxy inmediato y Nginx
# reenvía la IP real y el esquema del proxy externo (ver sección TLS del README).
# Si cambias la subred en docker-compose.prod.yml, actualiza este valor.
TRUSTED_PROXIES=172.28.0.0/16

# HSTS: solo se envía cuando la petición llega por HTTPS (directo o con
# X-Forwarded-Proto). En producción actívalo; `includeSubDomains` solo si todos
# los subdominios del dominio sirven HTTPS.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false

# Límites de peticiones por minuto
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_IP=20
RATE_LIMIT_API_ANON=30
RATE_LIMIT_API=120
RATE_LIMIT_REPORTS=30
# Los PDF son más caros que el JSON y tienen su propio cupo.
RATE_LIMIT_REPORTS_PDF=5
# `/up` está fuera del grupo `api` y tiene su propio cupo por IP.
RATE_LIMIT_HEALTH=30
# La exportación CSV de auditoría tiene un cupo estricto por usuario.
RATE_LIMIT_AUDIT_EXPORT=10

# Filas máximas del reporte de ventas (0 desactiva el límite)
REPORTS_MAX_ROWS=500
SALES_MIN_DATE=2000-01-01

# Días de retención de audit_logs antes de que `audit:prune` los elimine.
AUDIT_RETENTION_DAYS=90

# Exige cambiar la contraseña temporal antes de operar con la API. Actívalo
# cuando todos los clientes sepan manejar el 403 de `must_change_password`.
ENFORCE_PASSWORD_CHANGE=false

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
# stderr evita escribir en storage/logs y deja que Docker recoja la salida.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Base de datos (servicio postgres de docker-compose.prod.yml)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=api_laravel_car_agency
# Rol de aplicación (no superusuario), creado por docker/postgres/init.
DB_USERNAME=car_agency
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# `prefer` cifra la conexión si el servidor ofrece TLS y sigue funcionando si no.
# El contenedor `postgres` de este compose no habilita TLS; con un PostgreSQL
# gestionado (PaaS) sube a `require` o `verify-full`.
DB_SSLMODE=prefer
# Sesión de PostgreSQL en UTC: la API guarda y compara fechas en UTC.
DB_TIMEZONE=UTC
# URL completa alternativa (`pgsql://usuario:clave@host:puerto/base`). Vacía para
# usar las variables de arriba.
DB_URL=

# Variables que consume la imagen postgres:17. POSTGRES_APP_PASSWORD debe
# coincidir con DB_PASSWORD: la app entra con el rol car_agency, que el script
# de inicialización hace dueño de la base y del schema public. POSTGRES_PASSWORD
# es solo del superusuario y no lo usa la API.
POSTGRES_DB=api_laravel_car_agency
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
POSTGRES_APP_USER=car_agency
POSTGRES_APP_PASSWORD=CHANGE_ME_DB_PASSWORD

# Ajuste de PostgreSQL. shared_buffers = 25-50 % de la RAM del servidor:
# 2 GB → 512MB/1GB, 4 GB → 1GB/2GB, 8 GB → 2GB/4GB. El log de consultas lentas
# (en milisegundos) se escribe en `docker compose logs postgres`.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=8MB
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000
POSTGRES_INITDB_ARGS="--locale=C.UTF-8 --encoding=UTF8"

# -----------------------------------------------------------------------------
# Sesiones, caché y colas (sin Redis: PostgreSQL + archivos)
# -----------------------------------------------------------------------------
# Caché y colas usan las tablas `cache`, `jobs` y `failed_jobs`, creadas por
# `php artisan migrate` (paso 3 del README).
# Laravel 12 lee el store activo de CACHE_STORE; CACHE_DRIVER se mantiene por
# compatibilidad con despliegues y configuraciones antiguas.
CACHE_STORE=database
CACHE_DRIVER=database
CACHE_PREFIX=car_agency

# Las sesiones se escriben en storage/framework/sessions, dentro del volumen
# nombrado app-storage, así que www-data no depende de permisos del host.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Resto de servicios
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
