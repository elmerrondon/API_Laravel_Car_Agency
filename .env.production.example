# =============================================================================
# Plantilla de entorno para PRODUCCIÓN
#
# Es segura para versionar: no contiene credenciales reales, solo marcadores
# CHANGE_ME_*. Uso:
#
#   cp .env.production.example .env.production
#   # sustituye todos los CHANGE_ME_* y genera la APP_KEY:
#   docker compose -f docker-compose.prod.yml --env-file .env.production \
#     run --rm app php artisan key:generate --show
#
# .env.production está ignorado por Git (ver .gitignore); nunca lo subas.
# =============================================================================

APP_NAME="Car Agency"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# Versión que se publica en /docs/api.json
API_VERSION=1.0.0

# La documentación OpenAPI queda cerrada en producción salvo que se active
# explícitamente. Las dev tools nunca se cargan en producción.
DOCS_ENABLED=false
SCRAMBLE_DEV_TOOLS=false

# Minutos de vida de los tokens Bearer de Sanctum
SANCTUM_EXPIRATION=120

# Segundos que se cachean los permisos del usuario (0 desactiva la caché)
PERMISSIONS_CACHE_TTL=300

# Dominios reales separados por comas. Nunca uses "*" en producción.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Límites de peticiones por minuto
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=120
RATE_LIMIT_REPORTS=30

# Filas máximas del reporte de ventas (0 desactiva el límite)
REPORTS_MAX_ROWS=500

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
# stderr evita escribir en storage/logs y deja que Docker recoja la salida.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Base de datos (servicio mysql de docker-compose.prod.yml)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=api_laravel_car_agency
DB_USERNAME=car_agency
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Variables que consume la imagen oficial mysql:8.0. Mantenlas sincronizadas
# con DB_DATABASE/DB_USERNAME/DB_PASSWORD para que la app y el contenedor
# coincidan: la imagen crea MYSQL_USER con permisos sobre MYSQL_DATABASE.
MYSQL_DATABASE=api_laravel_car_agency
MYSQL_USER=car_agency
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# -----------------------------------------------------------------------------
# Sesiones, caché y colas (sin Redis: MySQL + archivos)
# -----------------------------------------------------------------------------
# Caché y colas usan las tablas `cache`, `jobs` y `failed_jobs`, creadas por
# `php artisan migrate` (paso 3 del README).
# Laravel 12 lee el store activo de CACHE_STORE; CACHE_DRIVER se mantiene por
# compatibilidad con despliegues y configuraciones antiguas.
CACHE_STORE=database
CACHE_DRIVER=database
CACHE_PREFIX=car_agency

# Las sesiones se escriben en storage/framework/sessions, dentro del volumen
# nombrado app-storage, así que www-data no depende de permisos del host.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Resto de servicios
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
