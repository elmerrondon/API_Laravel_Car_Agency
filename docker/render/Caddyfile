{
	frankenphp
	order php_server before file_server
}

# Caddyfile de la imagen monolítica (Render / Railway / Fly.io).
#
# FrankenPHP = Caddy + PHP embebido. El puerto se toma de $PORT, que Render y
# Railway inyectan automáticamente; en local cae a 8080.
#
# :{$PORT:8080} es una dirección sin hostname, así que Caddy NO activa HTTPS
# automático: la terminación TLS la hace la plataforma (Render/Railway).
:{$PORT:8080} {
	root * /var/www/html/public

	encode zstd br gzip

	# Cabeceras de seguridad. La plataforma termina TLS, pero estas cabeceras
	# las añade Caddy en cada respuesta (incluidos los errores). HSTS lo pone
	# la aplicación solo sobre HTTPS.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer-when-downgrade"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		-Server
	}

	# CSP solo para la documentación interactiva (Stoplight Elements carga JS y
	# CSS desde unpkg.com y usa scripts inline).
	header /docs/api Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: https://unpkg.com; font-src 'self' data: https://unpkg.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

	# Logs de acceso a stdout para que la plataforma los recolecte.
	log {
		output stdout
	}

	# Sirve /index.php para todo lo que no sea un archivo estático y ejecuta
	# PHP con el worker de FrankenPHP.
	php_server
}
