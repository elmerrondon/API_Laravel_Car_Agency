# syntax=docker/dockerfile:1

# Etapa 1: imagen PHP de producción ya construida por docker-compose.prod.yml.
# Se usa solo como fuente de los estáticos de Laravel (public/).
# Requiere construir primero la app:
#   docker compose -f docker-compose.prod.yml --env-file .env.production build app
FROM car-agency-laravel-api:prod AS app

# Etapa 2: Nginx sirve los estáticos y delega PHP a app:9000.
FROM nginx:1.27-alpine

COPY --from=app /var/www/html/public /var/www/html/public
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# La imagen base de Nginx ya define CMD ["nginx", "-g", "daemon off;"].
